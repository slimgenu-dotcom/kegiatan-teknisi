rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Ganti dengan email admin Anda (harus sama dengan ADMIN_EMAIL di index.html)
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'admin@gmail.com';
    }

    match /kegiatan/{doc} {
      // Semua pengguna aplikasi (teknisi & admin) boleh MELIHAT riwayat
      allow read: if request.auth != null;

      // Teknisi & admin boleh MENAMBAH catatan
      allow create: if request.auth != null
        && request.resource.data.teknisi in ['Abdul Mufid', 'Wawan']
        && request.resource.data.jenis in ['Maintenance', 'PSB'];

      // Hanya admin yang boleh MENGHAPUS catatan
      allow delete: if isAdmin();

      // Satu-satunya perubahan yang diizinkan: pembersihan foto otomatis,
      // yaitu mengosongkan foto setelah lewat batas waktu (hapusFotoPada).
      // Teks catatan tidak bisa diedit oleh siapa pun.
      allow update: if request.auth != null
        && 'hapusFotoPada' in resource.data
        && resource.data.hapusFotoPada <= request.time
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['foto', 'fotoDihapus', 'hapusFotoPada'])
        && request.resource.data.foto.size() == 0
        && request.resource.data.fotoDihapus == true;
    }
  }
}
